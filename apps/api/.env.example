# Aether 2.0 — local configuration (copy to .env; never commit real values).
AETHER_DATABASE_URL=postgresql+psycopg://aether:<password>@127.0.0.1:55432/aether
AETHER_STORAGE_ROOT=./.data
AETHER_STAC_API_URL=https://earth-search.aws.element84.com/v1
AETHER_STAC_COLLECTION=sentinel-2-c1-l2a
AETHER_BIND_HOST=127.0.0.1
AETHER_LOG_LEVEL=INFO
# Integration tests only (separate database; dropped and re-migrated by the test suite)
AETHER_TEST_DATABASE_URL=postgresql+psycopg://aether:<password>@127.0.0.1:55432/aether_test
